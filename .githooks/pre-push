#!/usr/bin/env bash
set -euo pipefail

if [[ "${ECC_SKIP_GIT_HOOKS:-0}" == "1" || "${ECC_SKIP_PREPUSH:-0}" == "1" ]]; then
  exit 0
fi

if ! command -v uv >/dev/null 2>&1; then
  printf 'pre-push: uv is required; see README.md\n' >&2
  exit 1
fi

printf 'pre-push: verifying the locked uv project\n'
uv sync --locked --group dev --group notebook
uv run ruff check .
uv run ruff format --check .
uv run python -m unittest discover -s tests -v
printf 'pre-push: verification passed\n'
